# Copy this file to .env for local runs.
# Get a key from https://orcarouter.ai
ORCAROUTER_API_KEY=your_orcarouter_api_key_here

# Classroom admin password (default is admin if unset).
# On Vercel set this in Project Settings → Environment Variables, not here.
ADMIN_PASSWORD=

# For a live classroom on Vercel: Storage → Create Database → Redis (Upstash).
# Connecting the store injects these automatically:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
