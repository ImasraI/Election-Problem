# Copy this file to .env and paste your OrcaRouter API key.
# Get a key from https://orcarouter.ai
ORCAROUTER_API_KEY=your_orcarouter_api_key_here

# Classroom admin password (default is admin if unset)
ADMIN_PASSWORD=failshod

# For live classroom on Vercel: add Upstash Redis in the Vercel dashboard
# (Storage → Create Database → Redis). These are injected automatically
# when the store is connected to the project:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
